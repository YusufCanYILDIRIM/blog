# Bu dosyayı `.env` olarak kopyalayın. Gerçek secret değerleri hiçbir zaman
# commit edilmez; `.env*` dosyaları (bu örnek hariç) git tarafından yok sayılır.
# Prisma CLI ve Next.js ikisi de `.env` dosyasını okur.

####################################
# VERİTABANI (bkz. docker-compose.yml)
####################################

# Yerel docker compose için parola (yalnızca 127.0.0.1'e açılır).
POSTGRES_PASSWORD="postgres"
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/blogdb?schema=public"

# Entegrasyon testleri için AYRI veritabanı. Adı "_test" ile bitmeli; testler
# bu veritabanındaki tabloları temizler.
TEST_DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/blogdb_test?schema=public"

####################################
# UYGULAMA (public — istemciye gömülür, secret içermez)
####################################

# Production build'de zorunludur.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

####################################
# KİMLİK DOĞRULAMA — Aşama 3'te bağlanacak (bkz. docs/adr/0001-auth-better-auth.md)
####################################

# BETTER_AUTH_SECRET=
# BETTER_AUTH_URL="http://localhost:3000"
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# İzinli iki yazarın sayısal GitHub kullanıcı kimlikleri, virgülle ayrılmış.
# Kimlik: https://api.github.com/users/<kullanıcı-adı> yanıtındaki "id" alanı.
# AUTHOR_GITHUB_IDS=
